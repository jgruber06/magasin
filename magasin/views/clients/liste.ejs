<%- include('../header') %>
<div class="ui main container">
  <h2>Clients</h2>
  <% if (erreur) { %>
    <div class="ui negative message">Suppression impossible : ce client a des commandes.</div>
  <% } %>
  <a class="ui primary button" href="/clients/add">Ajouter un client</a>
  <table class="ui celled table">
    <thead><tr><th>Nom</th><th>Prénom</th><th>Email</th><th>Adresse de livraison</th><th></th></tr></thead>
    <tbody>
      <% if (!clients.length) { %><tr><td colspan="5">Aucun client pour l'instant.</td></tr><% } %>
      <% clients.forEach(function(c) { %>
        <tr>
          <td><%= c.Nom %></td>
          <td><%= c.Prenom %></td>
          <td><%= c.Email %></td>
          <td><%= c.Adresse_livraison %></td>
          <td>
            <a class="ui button" href="/clients/edit/<%= c.Id %>">Modifier</a>
            <form action="/clients/delete/<%= c.Id %>" method="post" style="display:inline"
                  onsubmit="return confirm('Supprimer ce client ?')">
              <button class="ui red button" type="submit">Supprimer</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('../footer') %>
