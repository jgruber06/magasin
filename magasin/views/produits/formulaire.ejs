<%- include('../header') %>
<div class="ui main container">
  <h2><%= produit.Id ? 'Modifier le produit' : 'Nouveau produit' %></h2>
  <form class="ui form" method="post"
        action="<%= produit.Id ? '/produits/edit/' + produit.Id : '/produits/add' %>">
    <div class="field">
      <label>Nom</label>
      <input type="text" name="Nom" value="<%= produit.Nom || '' %>" required>
    </div>
    <div class="field">
      <label>Description</label>
      <input type="text" name="Description" value="<%= produit.Description || '' %>">
    </div>
    <div class="two fields">
      <div class="field">
        <label>Prix (€)</label>
        <input type="number" name="Prix" step="0.01" min="0" value="<%= produit.Prix ?? '' %>" required>
      </div>
      <div class="field">
        <label>Stock</label>
        <input type="number" name="Stock" min="0" value="<%= produit.Stock ?? '' %>" required>
      </div>
    </div>
    <div class="field">
      <label>Catégorie</label>
      <select name="Id_categorie" required>
        <option value="">Choisir une catégorie</option>
        <% categories.forEach(function(c) { %>
          <option value="<%= c.Id %>" <%= c.Id === produit.Id_categorie ? 'selected' : '' %>><%= c.Nom %></option>
        <% }) %>
      </select>
    </div>
    <button class="ui primary button" type="submit">Enregistrer</button>
    <a class="ui button" href="/produits">Annuler</a>
  </form>
</div>
<%- include('../footer') %>
